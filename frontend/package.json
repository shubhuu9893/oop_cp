{
  "name": "cachebrowse-frontend",
  "version": "1.0.0",
  "main": "desktop/main.cjs",
  "description": "CacheBrowse React desktop browser UI",
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "install:electron": "node node_modules/electron/install.js",
    "dev": "node desktop/dev.mjs",
    "dev:web": "vite --host localhost --port 5173 --strictPort",
    "dev:desktop": "node desktop/dev.mjs",
    "build": "vite build",
    "test": "node --test",
    "smoke:desktop": "node desktop/smoke.cjs",
    "smoke:overlay": "node desktop/overlay-smoke.cjs",
    "start:desktop": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "vite": "^5.4.21"
  }
}
