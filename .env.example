# Cloudflare D1 REST API (never commit a populated .env)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token
D1_DATABASE_ID=your_d1_database_id

# Firebase Identity Toolkit email/password authentication
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id
CACHEBROWSE_DISABLE_FIREBASE=false

# Firebase Admin SDK uses Application Default Credentials. Keep the service-account
# key outside this repository and point GOOGLE_APPLICATION_CREDENTIALS to it.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-admin-service-account.json
# Set to the Firebase UID of the first administrator after that person registers.
CACHEBROWSE_ADMIN_UID=your_designated_admin_firebase_uid

# Optional application settings
SEARCH_ENGINE_URL=https://html.duckduckgo.com/html/?q=%s
CACHEBROWSE_API_PORT=8080
CACHEBROWSE_FRONTEND_PORT=5173
