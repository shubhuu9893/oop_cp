<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project Information -->
    <groupId>com.cachebrowse</groupId>
    <artifactId>cachebrowse</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>CacheBrowse</name>
    <description>
        Lightweight Java browser with caching proxy, LRU cache,
        TTL and ad/tracker blocking.
    </description>

    <!-- Properties -->
    <properties>

        <!-- Java -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JavaFX (kept for legacy ui/ classes that still compile against it) -->
        <javafx.version>21.0.8</javafx.version>

        <!-- JavaFX launcher — kept for `mvn javafx:run` if ever needed separately -->
        <main.class>com.cachebrowse.ui.BrowserApplication</main.class>

        <!-- Backend entry point — used by `mvn exec:java` -->
        <backend.main.class>com.cachebrowse.backend.CacheBrowseBackendApplication</backend.main.class>

    </properties>


    <!-- ========================= -->
    <!-- Dependencies -->
    <!-- ========================= -->

    <dependencies>
        <!-- Existing JavaFX dependencies remain unchanged -->

        <!-- JavaFX Base -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX Graphics -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX Controls -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX WebView -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Database layer (H2) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Machine Learning library (Smile) -->
        <dependency>
            <groupId>com.github.haifengl</groupId>
            <artifactId>smile-core</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- JSON for configuration, if needed -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- Firebase Admin: trusted verification of ID tokens and user directory access. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.3</version>
        </dependency>

        <!-- JUnit for tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
        
        </dependencies>


    <!-- ========================= -->
    <!-- Build -->
    <!-- ========================= -->

    <build>

        <plugins>

            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>

                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- ============================================================ -->
            <!-- exec-maven-plugin — starts the Java backend WITHOUT JavaFX.  -->
            <!-- Usage: mvn exec:java                                          -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Pure Java backend — no JavaFX Application.launch() -->
                    <mainClass>${backend.main.class}</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    <jvmArgs>
                        <!-- Memory settings suitable for the backend services -->
                        <jvmArg>-Xmx512m</jvmArg>
                        <jvmArg>-Xms128m</jvmArg>
                        <!-- G1GC for low-latency API responses -->
                        <jvmArg>-XX:+UseG1GC</jvmArg>
                        <jvmArg>-XX:MaxGCPauseMillis=100</jvmArg>
                        <!-- Silence JavaFX Prism warnings (JavaFX jars are on classpath
                             but we never initialize the JavaFX toolkit) -->
                        <jvmArg>-Djava.awt.headless=true</jvmArg>
                        <jvmArg>-Dprism.order=sw</jvmArg>
                        <jvmArg>-Djavafx.headless=true</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>


            <!-- Surefire: JUnit 5 / Jupiter support -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>

                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <options>
                        <!-- Stabilize Prism/WebView rendering on Linux.
                             Prevents the WCPageBackBufferImpl.validate / RTTexture null
                             texture crash by disabling GPU-side back-buffer invalidation
                             and forcing a more conservative rendering pipeline. -->
                        <option>-Dprism.vsync=true</option>
                        <option>-Djavafx.animation.pulse=60</option>
                        <option>-Dprism.dirtyopts=false</option>
                        <!-- Disable WebKit media resource warnings that cause log noise -->
                        <option>-Dcom.sun.webkit.network.URLs.suppressTLSErrors=true</option>
                        <!-- Increase JavaFX media buffer for smoother video playback.
                             Default is small; this gives the media pipeline more headroom. -->
                        <option>-Djavafx.media.jfxmedia.enabled=true</option>
                        <!-- Ensure JavaFX uses enough memory for video rendering textures -->
                        <option>-Xmx512m</option>
                        <option>-Xms128m</option>
                        <!-- Reduce GC pause impact on the rendering thread -->
                        <option>-XX:+UseG1GC</option>
                        <option>-XX:MaxGCPauseMillis=50</option>
                    </options>
                </configuration>

            </plugin>

        </plugins>

    </build>

</project>
