<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project Information -->
    <groupId>com.cachebrowse</groupId>
    <artifactId>cachebrowse</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>CacheBrowse</name>
    <description>
        Headless Java backend service with caching proxy, LRU cache,
        TTL, ad/tracker blocking, and REST APIs for the React frontend.
    </description>

    <!-- Properties -->
    <properties>

        <!-- Java -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Headless backend entry point -->
        <main.class>com.cachebrowse.backend.CacheBrowseBackendApplication</main.class>
        <backend.main.class>com.cachebrowse.backend.CacheBrowseBackendApplication</backend.main.class>

    </properties>


    <!-- ========================= -->
    <!-- Dependencies -->
    <!-- ========================= -->

    <dependencies>

        <!-- Database layer (H2) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Machine Learning library (Smile) -->
        <dependency>
            <groupId>com.github.haifengl</groupId>
            <artifactId>smile-core</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- JSON for configuration and serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- Firebase Admin: trusted server-side verification of Firebase ID tokens. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.3</version>
        </dependency>

        <!-- JUnit for tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
        
    </dependencies>


    <!-- ========================= -->
    <!-- Build -->
    <!-- ========================= -->

    <build>

        <plugins>

            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>

                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- ============================================================ -->
            <!-- exec-maven-plugin — starts the headless Java backend.        -->
            <!-- Usage: mvn exec:java                                          -->
            <!-- ============================================================ -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Pure Java backend — headless service -->
                    <mainClass>${backend.main.class}</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    <jvmArgs>
                        <!-- Memory settings suitable for the backend services -->
                        <jvmArg>-Xmx512m</jvmArg>
                        <jvmArg>-Xms128m</jvmArg>
                        <!-- G1GC for low-latency API responses -->
                        <jvmArg>-XX:+UseG1GC</jvmArg>
                        <jvmArg>-XX:MaxGCPauseMillis=100</jvmArg>
                        <!-- Headless execution: no desktop, no window toolkit -->
                        <jvmArg>-Djava.awt.headless=true</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>


            <!-- Surefire: JUnit 5 / Jupiter support -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>

    </build>

</project>
